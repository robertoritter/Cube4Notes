<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no Windows abre sem a tela preta do console (no Linux e no macOS não muda nada) -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>icone/cube4notes.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Cube4Notes</AssemblyName>
    <RootNamespace>Cube4Notes</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- o código-fonte da interface (web/) e o servidor de teste (dev/) não fazem parte do executável -->
    <DefaultItemExcludes>$(DefaultItemExcludes);web/**;dev/**;notas-exemplo/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- janela própria multiplataforma: WebView2 (Windows), WebKitGTK (Linux), WebKit (macOS) -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- interface já compilada; vai embutida no executável (Cube4Notes.exe é um arquivo único) -->
    <Content Remove="wwwroot/**" />
    <None Remove="wwwroot/**" />
    <EmbeddedResource Include="wwwroot/**" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="icone/cube4notes.ico" LogicalName="icone/cube4notes.ico" />
  </ItemGroup>

</Project>
